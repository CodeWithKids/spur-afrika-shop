# Public site URL (no trailing slash) — used for PayHero callback_url
SITE_URL=http://localhost:5173

# PayHero — prefer the Basic token copied from the PayHero dashboard
# Either set PAYHERO_BASIC_AUTH alone, or username + password (we build Basic auth)
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
# Optional; not used by current checkout webhook yet
PAYHERO_API_SECRET=
PAYHERO_CHANNEL_ID=

# Supabase (service role — server only, never expose to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
